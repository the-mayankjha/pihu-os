{
  "productName": "Pihu OS",
  "version": "1.0.0",
  "identifier": "com.mayankjha.pihuos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run browser:prepare && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pihu OS",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/stt_server.py",
      "python/tts_server.py",
      "python/wakeword.py",
      "python/ytmusic_server.py",
      "python/requirements.txt",
      "python/automations/macos/pihu-macos-automation-v2/",
      "../models/wakeWord/*",
      "../bin/pihu-project-mcp.js",
      "../bin/browser-runtime/",
      "pihu-first-launch.sh"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Mayank Jha. All rights reserved.",
    "shortDescription": "AI-powered desktop OS companion with voice control",
    "longDescription": "Pihu OS is an AI-powered desktop companion featuring voice control (wake word, STT, TTS), YouTube Music integration, Google Workspace tools, project scaffolding across 10+ languages, and a beautiful macOS-style desktop environment.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      },
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "headerImage": null,
        "sidebarImage": null
      },
      "wix": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["python3", "python3-pip", "python3-venv", "portaudio19-dev"]
      }
    }
  }
}
