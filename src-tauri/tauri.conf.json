{
  "productName": "Pihu OS",
  "version": "1.2.6",
  "identifier": "com.mayankjha.pihuos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node bin/prepare-desktop-build.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pihu OS",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pihu"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RjI3ODNFODFBNUM4MzYKUldRMnlLV0JQbmp5OTROQzVka1J6Q3YzZkE4cjkzN3FNd0M1eFlhcy90Q3kySUJpeU9nOWFhOEEK",
      "endpoints": [
        "https://github.com/the-mayankjha/pihu-os/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "pihu_mcps/mcp/servers/google_oauth_server.py",
      "pihu_mcps/mcp/servers/google_api_client.py",
      "pihu_mcps/mcp/servers/google_oauth_page.html",
      "pihu_mcps/mcp/servers/pihu-logo.png",
      "mcp-agent-bundle/agent/",
      "mcp-agent-bundle/mcp/servers/",
      "python/stt_server.py",
      "python/tts_server.py",
      "python/wakeword.py",
      "python/ytmusic_server.py",
      "python/language/",
      "python/requirements.txt",
      "python/automations/macos/pihu-macos-automation-v2/",
      "../models/wakeWord/*",
      "../bin/pihu-project-mcp.js",
      "../bin/browser-runtime/",
      "../bin/spotify-runtime/",
      "runtime/whatsapp-bridge/*",
      "runtime/tts/hub/",
      "pihu-first-launch.sh"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Mayank Jha. All rights reserved.",
    "shortDescription": "AI-powered desktop OS companion with voice control",
    "longDescription": "Pihu OS is an AI-powered desktop companion featuring voice control (wake word, STT, TTS), YouTube Music integration, Google Workspace tools, project scaffolding across 10+ languages, and a beautiful macOS-style desktop environment.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "headerImage": null,
        "sidebarImage": null
      },
      "wix": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "python3",
          "python3-pip",
          "python3-venv",
          "portaudio19-dev"
        ]
      }
    }
  }
}
