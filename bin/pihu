#!/usr/bin/env node

/**
 * PIHU OS Executable Launcher (bin/pihu)
 *
 * Pre-configures ALL environment variables, API keys, client secrets,
 * Google OAuth credentials, and YTMusic OAuth, then launches PIHU OS.
 *
 * Usage:
 *   ./bin/pihu           # Auto-detect: compiled binary → tauri dev
 *   ./bin/pihu dev       # Force tauri dev mode
 *   ./bin/pihu build     # Build release binary (npm run tauri build)
 *   ./bin/pihu setup     # Run full environment setup (python setup.py)
 *   ./bin/pihu mcp       # Start pihu-project-mcp server
 */

import { spawn, execSync } from 'child_process';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = path.resolve(__dirname, '..');
const HOME = process.env.HOME || '/Users/mayankjha';

// ─── Color helpers ──────────────────────────────────
const C = {
  reset: '\x1b[0m', bold: '\x1b[1m', dim: '\x1b[2m',
  cyan: '\x1b[96m', green: '\x1b[92m', yellow: '\x1b[93m',
  magenta: '\x1b[95m', red: '\x1b[91m', blue: '\x1b[94m',
};

function log(icon, msg) { console.log(`${C.cyan}${icon}${C.reset} ${msg}`); }
function ok(msg) { console.log(`  ${C.green}✔${C.reset} ${msg}`); }
function warn(msg) { console.log(`  ${C.yellow}⚠${C.reset} ${msg}`); }

// ─── 1. Load .env file ────────────────────────────────
function loadEnvFile() {
  const envPath = path.join(ROOT_DIR, '.env');
  if (!fs.existsSync(envPath)) return;
  const content = fs.readFileSync(envPath, 'utf8');
  for (const line of content.split('\n')) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const eqIdx = trimmed.indexOf('=');
    if (eqIdx < 1) continue;
    const key = trimmed.slice(0, eqIdx).trim();
    const val = trimmed.slice(eqIdx + 1).trim();
    // .env overrides everything so keys are always current
    process.env[key] = val;
  }
}

// ─── 2. Environment fallback defaults ───────────────────
function ensureDefaults() {
  const defaults = {
    VITE_GEMINI_API_KEYS: process.env.VITE_GEMINI_API_KEYS || process.env.GEMINI_API_KEY || '',
    VITE_ELEVENLABS_VOICE_ID: process.env.VITE_ELEVENLABS_VOICE_ID || '21m00Tcm4TlvDq8ikWAM',
    GOOGLE_CLIENT_ID: process.env.GOOGLE_CLIENT_ID || '',
    GOOGLE_CLIENT_SECRET: process.env.GOOGLE_CLIENT_SECRET || '',
    YTMUSIC_CLIENT_ID: process.env.YTMUSIC_CLIENT_ID || '',
    YTMUSIC_CLIENT_SECRET: process.env.YTMUSIC_CLIENT_SECRET || '',
    PORT: process.env.PORT || '5173',
    PIHU_ENV: process.env.PIHU_ENV || 'production',
  };
  for (const [k, v] of Object.entries(defaults)) {
    if (!process.env[k] && v) process.env[k] = v;
  }
}

// ─── 3. Write Google OAuth credentials.json files ─────
function writeGoogleCredentials() {
  const clientId = process.env.GOOGLE_CLIENT_ID;
  const clientSecret = process.env.GOOGLE_CLIENT_SECRET;
  if (!clientId || !clientSecret) return;

  const credData = JSON.stringify({
    installed: {
      client_id: clientId,
      client_secret: clientSecret,
      auth_uri: 'https://accounts.google.com/o/oauth2/auth',
      token_uri: 'https://oauth2.googleapis.com/token',
      redirect_uris: ['http://localhost:8080/oauth2callback'],
    }
  }, null, 2);

  const credPaths = [
    path.join(HOME, '.gworkspace-mcp', 'credentials.json'),
    path.join(HOME, '.config', 'google-workspace-mcp', 'credentials.json'),
  ];

  for (const p of credPaths) {
    try {
      fs.mkdirSync(path.dirname(p), { recursive: true });
      fs.writeFileSync(p, credData, 'utf8');
      ok(`Google OAuth credentials → ${p}`);
    } catch (e) {
      warn(`Could not write ${p}: ${e.message}`);
    }
  }

  // Also update Antigravity tokens file with client_id/secret
  const agiTokensPath = path.join(HOME, '.gemini', 'antigravity', 'google_workspace_tokens.json');
  try {
    let tokenData = {};
    if (fs.existsSync(agiTokensPath)) {
      tokenData = JSON.parse(fs.readFileSync(agiTokensPath, 'utf8'));
    }
    tokenData.client_id = clientId;
    tokenData.client_secret = clientSecret;
    fs.mkdirSync(path.dirname(agiTokensPath), { recursive: true });
    fs.writeFileSync(agiTokensPath, JSON.stringify(tokenData, null, 2), 'utf8');
    ok(`Antigravity tokens → ${agiTokensPath}`);
  } catch (e) {
    warn(`Could not write Antigravity tokens: ${e.message}`);
  }
}

// ─── 4. Write PIHU OS config dir ──────────────────────
function writePihuConfig() {
  const configDir = path.join(HOME, '.pihu-os');
  fs.mkdirSync(configDir, { recursive: true });

  // Write a master config JSON
  const configPath = path.join(configDir, 'config.json');
  const config = {
    version: '1.0.0',
    created_at: new Date().toISOString(),
    google_oauth: {
      client_id: process.env.GOOGLE_CLIENT_ID,
      client_secret: process.env.GOOGLE_CLIENT_SECRET,
    },
    ytmusic_oauth: {
      client_id: process.env.YTMUSIC_CLIENT_ID,
      client_secret: process.env.YTMUSIC_CLIENT_SECRET,
      oauth_file: path.join(configDir, 'ytmusic_oauth.json'),
    },
    gemini: {
      api_keys: (process.env.VITE_GEMINI_API_KEYS || '').split(',').map(k => k.trim()).filter(Boolean),
    },
    elevenlabs: {
      voice_id: process.env.VITE_ELEVENLABS_VOICE_ID || '',
      api_key: process.env.VITE_ELEVENLABS_API_KEY || '',
    },
  };
  try {
    fs.writeFileSync(configPath, JSON.stringify(config, null, 2), 'utf8');
    ok(`PIHU OS config → ${configPath}`);
  } catch (e) {
    warn(`Could not write PIHU config: ${e.message}`);
  }
}

// ─── 5. Banner ────────────────────────────────────────
function printBanner(mode) {
  console.log(`
${C.magenta}${C.bold}  ╭─────────────────────────────────────────────╮
  │                                             │
  │        🟣  P I H U   O S  v1.0.0  🟣       │
  │           Your AI Desktop Companion         │
  │                                             │
  ╰─────────────────────────────────────────────╯${C.reset}
  ${C.dim}Mode: ${mode} | Root: ${ROOT_DIR}${C.reset}
`);
}

// ─── Main ─────────────────────────────────────────────
const subcommand = process.argv[2] || 'auto';

loadEnvFile();
ensureDefaults();

switch (subcommand) {

  case 'setup': {
    printBanner('setup');
    log('🔧', 'Running full PIHU OS environment setup...');
    writeGoogleCredentials();
    writePihuConfig();
    const child = spawn('python3', ['setup.py'], { cwd: ROOT_DIR, stdio: 'inherit', env: process.env });
    child.on('exit', (code) => process.exit(code || 0));
    break;
  }

  case 'build': {
    printBanner('build');
    log('📦', 'Building PIHU OS release binary...');
    writeGoogleCredentials();
    writePihuConfig();
    const child = spawn('npx', ['tauri', 'build'], { cwd: ROOT_DIR, stdio: 'inherit', env: process.env, shell: true });
    child.on('exit', (code) => {
      if (code === 0) {
        ok('Build complete! Binary at src-tauri/target/release/');
        const bundlePath = path.join(ROOT_DIR, 'src-tauri', 'target', 'release', 'bundle', 'macos');
        if (fs.existsSync(bundlePath)) ok(`macOS App Bundle: ${bundlePath}`);
      }
      process.exit(code || 0);
    });
    break;
  }

  case 'dev': {
    printBanner('dev');
    writeGoogleCredentials();
    writePihuConfig();
    log('⚡', 'Starting PIHU OS in Tauri Dev mode...');
    log('🔑', `Gemini API Keys: ${(process.env.VITE_GEMINI_API_KEYS || '').split(',').length} key(s) loaded`);
    log('🌐', `Google OAuth Client: ${process.env.GOOGLE_CLIENT_ID?.slice(0, 20)}...`);
    log('🎵', `YTMusic OAuth Client: ${process.env.YTMUSIC_CLIENT_ID?.slice(0, 20)}...`);
    const child = spawn('npx', ['tauri', 'dev'], { cwd: ROOT_DIR, stdio: 'inherit', env: process.env, shell: true });
    child.on('exit', (code) => process.exit(code || 0));
    break;
  }

  case 'mcp': {
    printBanner('mcp');
    log('🧩', 'Starting pihu-project-mcp server (stdio)...');
    const child = spawn('node', [path.join(ROOT_DIR, 'bin', 'pihu-project-mcp.js')], { stdio: 'inherit', env: process.env });
    child.on('exit', (code) => process.exit(code || 0));
    break;
  }

  case 'auto':
  default: {
    writeGoogleCredentials();
    writePihuConfig();

    // Check for compiled macOS .app bundle first
    const appBundle = path.join(ROOT_DIR, 'src-tauri', 'target', 'release', 'bundle', 'macos', 'Pihu OS.app');
    const releaseBin = path.join(ROOT_DIR, 'src-tauri', 'target', 'release', 'Pihu OS');

    if (fs.existsSync(appBundle)) {
      printBanner('app-bundle');
      log('✨', `Launching compiled macOS App: ${appBundle}`);
      log('🔑', `Gemini Keys: ${(process.env.VITE_GEMINI_API_KEYS || '').split(',').length} loaded`);
      log('🌐', `Google OAuth: ${process.env.GOOGLE_CLIENT_ID?.slice(0, 20)}...`);
      spawn('open', [appBundle], { stdio: 'inherit', env: process.env });
    } else if (fs.existsSync(releaseBin)) {
      printBanner('release-binary');
      log('✨', `Launching compiled binary: ${releaseBin}`);
      const child = spawn(releaseBin, [], { stdio: 'inherit', env: process.env });
      child.on('exit', (code) => process.exit(code || 0));
    } else {
      printBanner('tauri-dev');
      log('⚡', 'No compiled binary found. Falling back to Tauri Dev...');
      log('🔑', `Gemini API Keys: ${(process.env.VITE_GEMINI_API_KEYS || '').split(',').length} key(s) loaded`);
      log('🌐', `Google OAuth Client: ${process.env.GOOGLE_CLIENT_ID?.slice(0, 20)}...`);
      log('🎵', `YTMusic OAuth Client: ${process.env.YTMUSIC_CLIENT_ID?.slice(0, 20)}...`);
      const child = spawn('npx', ['tauri', 'dev'], { cwd: ROOT_DIR, stdio: 'inherit', env: process.env, shell: true });
      child.on('exit', (code) => process.exit(code || 0));
    }
    break;
  }
}
