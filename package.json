{
  "name": "Pihu-OS",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "PIDS=$(lsof -ti:5173,48126 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS 2>/dev/null; fi || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "mcp:project": "node bin/pihu-project-mcp.js",
    "start": "node bin/pihu",
    "pihu:dev": "node bin/pihu dev",
    "pihu:build": "node bin/pihu build",
    "pihu:dmg": "mkdir -p src-tauri/target/release/bundle/dmg && hdiutil create -volname 'Pihu OS' -srcfolder 'src-tauri/target/release/bundle/macos/Pihu OS.app' -ov -format UDZO 'src-tauri/target/release/bundle/dmg/Pihu OS_1.0.0_aarch64.dmg'",
    "pihu:setup": "node bin/pihu setup",
    "browser:prepare": "npm ci --prefix bin/browser-runtime --omit=dev",
    "mcp:browser": "node node_modules/@playwright/mcp/cli.js --browser chrome"
  },
  "bin": {
    "pihu": "./bin/pihu",
    "pihu-project-mcp": "./bin/pihu-project-mcp.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elevenlabs/elevenlabs-js": "^2.53.1",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "@tauri-apps/api": "^2.11.0",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-rnd": "^10.5.3",
    "react-youtube": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "thinking-orbs": "^0.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
